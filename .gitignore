# OS-specific files
# =========================
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db

# =========================
# NDK / C++ / Native
# =========================
.externalNativeBuild/
.cxx/
obj/
*.so
backup
# ...except actual source code that happens to live in a directory named "backup"
# (the pattern above is for native-build artifacts, e.g. whisper.cpp's .so safety backup).
!vox-hub/src/main/java/com/voxapps/hub/domain/backup/
!vox-hub/src/test/java/com/voxapps/hub/domain/backup/
!core/backup/
!core/backup/**
# Re-exclude build output within the un-ignored module above — a later "!" pattern otherwise wins
# over the earlier */build/ **/build/ rules for anything nested under core/backup/.
core/backup/build/
build-android-hybrid/

# =========================
# Keystore & Security
# =========================
*.jks
*.keystore
google-services.json

# =========================
# Compiled App Files
# =========================
*.apk
*.ap_
*.aab
*.dex
*.class

# =========================
# AI Models & Audio Cache
# =========================
# Heavy acoustic models — kept out so the repository stays usable
*.bin
*.pt
*.zip
*.bakcup
/app/src/main/assets/models/

# =========================
# Project-specific configuration
# =========================
/build

# OpenCV native build scratch dir (disposable CMake/ninja output, not source)
/vendor/opencv-android-build/

# OpenCV build output copied into ppocr-sdk by the autoCompileOpenCv Gradle task — regenerated
# from vendor/opencv, not source vendor/ppocr-sdk maintains itself.
/vendor/ppocr-sdk/opencv/

# Release signing keystore — never committed. Decoded from a GitHub Actions secret in CI
# (RELEASE_KEYSTORE_BASE64); local release builds are unsigned unless you set
# RELEASE_KEYSTORE_PATH/RELEASE_KEYSTORE_PASSWORD yourself.
*.jks
*.keystore
.artifacts/
.gradle_home/

# Schema signing private key. The public half (remote-schemas/signing-key.pub) is committed and
# embedded in the apps; the private half signs the manifest that decides whether a fetched schema is
# allowed to change what an install does. It belongs in the SCHEMA_SIGNING_KEY secret and nowhere else.
schema-signing.pem
*.signing.pem
