*.bin
*.pt
*.zip
*.bakcup
/app/src/main/assets/models/

# =========================
# Configurații specifice proiectului
# =========================
/build

# OpenCV native build scratch dir (disposable CMake/ninja output, not source)
/vendor/opencv-android-build/

# OpenCV build output copied into ppocr-sdk by the autoCompileOpenCv Gradle task — regenerated
# from vendor/opencv, not source vendor/ppocr-sdk maintains itself.
/vendor/ppocr-sdk/opencv/

# Release signing keystore — never committed. Decoded from a GitHub Actions secret in CI
# (RELEASE_KEYSTORE_BASE64); local release builds are unsigned unless you set
# RELEASE_KEYSTORE_PATH/RELEASE_KEYSTORE_PASSWORD yourself.
*.jks
*.keystore
.artifacts/
.gradle_home/
