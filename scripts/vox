#!/bin/bash
set -uo pipefail

# One door for everything in scripts/.
#
#     ./scripts/vox                     what exists
#     ./scripts/vox check               has anything upstream moved?
#     ./scripts/vox check vosk          just that one
#     ./scripts/vox patches verify      is each vendored fork upstream + its patches?
#     ./scripts/vox release package     build the APK that actually ships
#
# The pattern is the familiar one — mach, xtask, manage.py, a Makefile: a single documented entry
# point, with the individual scripts as implementation detail. It exists because finding the right
# script meant knowing that checking upstreams was check_upstream.sh, verifying patches was
# verify_vendored_patches.sh and regenerating them was regen_ppocr_sdk_patch.sh: three conventions
# for three neighbouring jobs.
#
# IMPORTANT: this dispatcher routes and documents. It does not initialise anything. Every script it
# calls must still work when run directly — that is what keeps a child debuggable in isolation and
# stops an invisible "only works via vox" contract forming.

# shellcheck source=scripts/lib/common.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"
cd "$VOX_ROOT" || exit 1

usage() {
    cat <<'EOF'
Usage: ./scripts/vox <flow> [command] [args...]

  check [name...]              Has anything upstream moved? (all, or named ones)
                                 vosk newpipe-extractor openwakeword opencv
                                 ppocr-sdk whisper docquad

  patches verify [module]      Assert a vendored fork is exactly upstream + its patches/
  patches regen <module>       Regenerate a fork's patches from its current source
                                 modules: ppocr-sdk wakeword

  release package              Build Commander's APK as published (stripped + signed)
  release sbom <app>           CycloneDX SBOM, including the vendored native sources
  release publish-libs         Publish whisper .so files as the DLC release
  release readme               Regenerate the README release table
  release fdroid               Regenerate and push F-Droid metadata

  native opencv                Build OpenCV from the pinned submodule
  native whisper               Build whisper.cpp from the pinned submodule

  schemas validate             Validate the shipped schema JSON
  schemas sign                 Sign the schemas (needs the private key)
  schemas verify               Check the manifest signature and every hash
  schemas keygen [out.pem]     Create a signing keypair (once, ever)
  schemas hash-models [engine] Download each model once and record its sha256

  test                         Test this machinery: the report contract, the
                               dispatcher, and the vendored invariant

Anything not listed here is an internal helper (scripts/lib/) called by the commands above, not
directly.
EOF
}

die() { log_error "$1"; echo; usage; exit 1; }

FLOW="${1:-}"; shift || true

case "$FLOW" in
    ""|-h|--help|help)
        usage
        ;;

    check)
        # `pairing` asks a different question from the upstream checks: not "has anything moved
        # upstream" but "do the native libraries in this APK actually satisfy each other".
        if [ "${1:-}" = "pairing" ]; then
            shift
            exec python3 scripts/check_native_pairing.py "$@"
        fi
        # `whisper-published` asks a third question: not what upstream has, nor whether an APK's
        # libraries agree, but whether the runtime the app downloads was built from the commit this
        # source pins. Those can differ because publishing that runtime is a manual step.
        if [ "${1:-}" = "whisper-published" ]; then
            shift
            exec bash scripts/check_whisper_published.sh "$@"
        fi
        exec bash scripts/check_upstream.sh "$@"
        ;;

    patches)
        CMD="${1:-}"; shift || true
        case "$CMD" in
            verify) exec bash scripts/verify_vendored_patches.sh "$@" ;;
            regen)
                case "${1:-}" in
                    ppocr-sdk) exec bash scripts/regen_ppocr_sdk_patch.sh ;;
                    wakeword)  exec bash scripts/regen_openwakeword_patch.sh ;;
                    *) die "patches regen needs a module: ppocr-sdk | wakeword" ;;
                esac
                ;;
            *) die "patches needs a command: verify | regen" ;;
        esac
        ;;

    release)
        CMD="${1:-}"; shift || true
        case "$CMD" in
            package)
                # `assembleRelease` produces the published APK itself — AGP does the DLC packaging,
                # for the bundle as well as the APK, so no post-build step remains that could make a
                # local artifact differ from CI's. This only fills the keystore in from its
                # conventional location, so a signed local release needs no env vars.
                #
                # VOX_DLC picks the mode, the same name the workflow uses:
                #     VOX_DLC=full ./scripts/vox release package
                : "${RELEASE_KEYSTORE_PATH:=$VOX_KEY_DIR/voxapps-release.jks}"
                if [ -z "${RELEASE_KEYSTORE_PASSWORD:-}" ] && [ -f "$VOX_KEY_DIR/keystore_password.txt" ]; then
                    RELEASE_KEYSTORE_PASSWORD=$(tr -d '[:space:]' < "$VOX_KEY_DIR/keystore_password.txt")
                fi
                [ -f "$RELEASE_KEYSTORE_PATH" ] || die "No keystore at $RELEASE_KEYSTORE_PATH — set RELEASE_KEYSTORE_PATH"
                export RELEASE_KEYSTORE_PATH RELEASE_KEYSTORE_PASSWORD
                exec "$VOX_ROOT/gradlew" -p "$VOX_ROOT" \
                    :vox-commander:assembleRelease -PvoxDlc="${VOX_DLC:-minimal}"
                ;;
            sbom)         exec bash scripts/generate_sbom.sh "$@" ;;
            publish-libs) exec bash scripts/publish_whisper_libs.sh "$@" ;;
            readme)       exec bash scripts/update_release_readme_links.sh "$@" ;;
            fdroid)       exec bash scripts/sync_fdroid_metadata.sh "$@" ;;
            *) die "release needs a command: package | sbom | publish-libs | readme | fdroid" ;;
        esac
        ;;

    native)
        case "${1:-}" in
            opencv)  exec bash scripts/build_opencv_android.sh ;;
            # bash, not sh: this sources scripts/lib/common.sh via ${BASH_SOURCE[0]}, and sh on the
            # Ubuntu runners is dash, which has neither that variable nor `source`. macOS's sh is
            # bash in POSIX mode and runs it happily, so the difference only appears in CI.
            whisper) exec bash scripts/check_whisper.sh "${@:2}" ;;
            *) die "native needs a target: opencv | whisper" ;;
        esac
        ;;

    test)
        exec bash scripts/tests/run.sh "$@"
        ;;

    schemas)
        case "${1:-}" in
            validate) exec python3 scripts/validate_schemas.py "${@:2}" ;;
            sign)     exec bash scripts/sign_schemas.sh sign ;;
            verify)   exec bash scripts/sign_schemas.sh verify ;;
            keygen)      exec bash scripts/sign_schemas.sh keygen "${2:-}" ;;
            hash-models) exec bash scripts/hash_models.sh "${@:2}" ;;
            *) die "schemas needs a command: validate | sign | verify | keygen | hash-models" ;;
        esac
        ;;

    *)
        die "Unknown flow: $FLOW"
        ;;
esac
