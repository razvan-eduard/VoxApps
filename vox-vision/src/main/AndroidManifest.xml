<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- LiveView's target-app pickers offer every installed app — a chat partner may be Signal,
         Viber, or anything else the person actually uses, which no closed intent query can
         enumerate. Same declaration, and the same reason, as vox-expenses' notification-source
         picker and vox-commander's app registry. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
        Both declarations are load-bearing: QUERY_ALL_PACKAGES above feeds the target-app pickers
        (which must offer everything installed), while these narrow queries are what chip-time
        resolveActivity checks ride on — the exact five ways recognised text can leave: dial,
        mail, map, browse/search, share.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Named apps with schemes of their own: the WhatsApp chip (either flavour) hides when
             WhatsApp is absent, and Waze is one of navigate's carriers. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.waze" />
    </queries>

    <!--
        The COMMAND/OCR_RESULT signature permissions guarding the receiver below, and letting
        OcrResultSender deliver a reply to ANY satellite (discovered dynamically — see
        ScanTargetDiscovery), are declared once in :core:ipc's own manifest (shared across every Vox
        app) and folded in here automatically via manifest merger — see VoxIpc.kt's class doc comment.
        No per-app <permission>/<uses-permission> declarations needed here, for any satellite, ever.
    -->

    <application
        android:name=".VisionApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoxVision">

        <activity
            android:name=".VisionActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">

            <!-- Standalone launcher: works fully without VoxCommander -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The second launcher icon, and the whole difference between the two modes: the alias
            carries no code and adds no extras — VisionActivity reads which component it was
            launched through and shows LiveView instead of the scan flow. A satellite's OCR_REQUEST
            always targets .VisionActivity directly, so it can never land here.
        -->
        <activity-alias
            android:name=".LiveView"
            android:targetActivity=".VisionActivity"
            android:exported="true"
            android:label="@string/liveview_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            Discovery handshake only for now — Vision doesn't consume commands yet (it's a producer
            of notes, not a consumer of voice commands). Commander's "Vox Apps" scan pings this to
            confirm Vision is installed and responding.
        -->
        <receiver
            android:name=".receiver.VisionCommandReceiver"
            android:exported="true"
            android:permission="com.voxapps.vox.permission.COMMAND">
            <intent-filter>
                <action android:name="com.voxapps.action.VOX_COMMAND" />
            </intent-filter>
            <meta-data android:name="com.voxapps.vox.domain" android:value="vision" />
            <meta-data android:name="com.voxapps.vox.actions" android:value="ping" />
            <meta-data android:name="com.voxapps.vox.label" android:value="Vision" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.voxapps.vision.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
