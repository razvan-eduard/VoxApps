<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The COMMAND permission guarding every satellite's receiver is declared once in :core:ipc's
        own manifest (shared across every Vox app) and folded in here automatically via manifest
        merger — see VoxIpc.kt's class doc comment. Hub is a pure IPC client (discovers satellites,
        requests export/import) — it holds no local database and exposes no receiver of its own.
    -->

    <!-- Peer-to-peer device sync (see domain/sync/): NFC pairing + Bluetooth Classic transport. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />

    <!-- Classic Bluetooth discovery/connect. Pre-31 needs location for scan results; 31+ replaces
         that with BLUETOOTH_SCAN/CONNECT (neverForLocation: we only ever match by device name, never
         derive physical location from scan results). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- VoxConnect Bridge (see :core:voxconnect's VoxConnectServer): an embedded local HTTP+WebSocket
         server a paired desktop app connects to over WiFi. Binding even a local listening socket
         requires INTERNET on Android. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Scanning the pairing QR shown on the PC (see VoxConnectQrScanner) — the phone always has a
         camera, unlike many desktop PCs, which is why pairing bootstrap goes this direction. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".HubApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoxHub">

        <activity
            android:name=".HubActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Grants Expenses temporary read access to a receipts zip staged here after extracting it
             from a picked import bundle (see HubScreen's readExportDocument) — the reverse direction
             of the same FileProvider mechanism Expenses uses to hand Hub photos on export. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.voxapps.hub.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The passive/card side of an NFC pairing tap — see PairingHceService's doc comment. Android
             wakes/binds this on its own via AID routing, no foreground UI required on this device. -->
        <service
            android:name=".domain.sync.PairingHceService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apduservice" />
        </service>
    </application>
</manifest>
