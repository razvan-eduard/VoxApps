<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Expenses live on-device; the only network use is Stage 5's exchange-rate lookup at
         reporting time (never per-expense), a plain outbound HTTPS GET to exchangerate-api.com. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Without this, queryIntentActivities() (LauncherAppsCache's notification-source app scan)
         is silently restricted by Android 11+ package-visibility filtering to a small OS-chosen
         set of "automatically visible" apps rather than every installed app — mirrors
         vox-commander's identical declaration for its own app registry/picker. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Android 13+ suppresses toasts from backgrounded apps unless notifications are allowed.
         Needed for the "toast on voice save" setting (the save is headless via broadcast). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the Notification Capture settings screen show the system's "Ignore battery
         optimizations?" dialog directly (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS) — without
         this, some OEMs' aggressive background-process killers unbind PaymentNotificationListenerService
         while backgrounded, silently missing payment notifications posted during the gap. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        The COMMAND/LLM_RESULT/OCR_RESULT/LLM_PROCESS signature permissions guarding the receivers
        below are declared once in :core:ipc's own manifest (shared across every Vox app) and folded
        in here automatically via manifest merger — see VoxIpc.kt's class doc comment. No per-app
        <permission>/<uses-permission> declarations needed here.
    -->

    <application
        android:name=".ExpensesApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoxExpenses">

        <activity
            android:name=".ExpensesActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name">

            <!-- Standalone launcher: works fully without VoxCommander -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            OPTIONAL Vox integration: VoxCommander (or any authorized app) hands us a JSON command
            (create/read) via this native broadcast. Parsed with :core:ipc — no shared runtime, no
            NLU here. Guarded by the COMMAND permission above.
        -->
        <receiver
            android:name=".receiver.VoxCommandReceiver"
            android:exported="true"
            android:permission="com.voxapps.vox.permission.COMMAND">
            <intent-filter>
                <action android:name="com.voxapps.action.VOX_COMMAND" />
            </intent-filter>
            <!-- Capability advertising: Commander reads this at scan time to route the "expenses"
                 NLU domain here (create/read), with no per-app config on Commander's side. -->
            <meta-data android:name="com.voxapps.vox.domain" android:value="expenses" />
            <meta-data android:name="com.voxapps.vox.actions" android:value="create,read,export,import,get_schema" />
            <meta-data android:name="com.voxapps.vox.label" android:value="Expenses" />
            <meta-data
                android:name="com.voxapps.vox.nluHint"
                android:value="If the user names a target category/budget (e.g. &quot;log to groceries&quot;, &quot;pune-o la transport&quot;), put that category name in the category field; otherwise category=null. Put everything else the user said about the purchase (items, vendor, amount, anything mentioned) into the text field verbatim — do not try to extract or compute the amount yourself, that happens separately." />
        </receiver>

        <!--
            Generic LLM hook result: Commander delivers an async reply here after parsing a raw
            spoken utterance (or, in later stages, a category-merge/dedup suggestion). Guarded by the
            LLM_RESULT permission above — only Commander (same signing key) can deliver it.
        -->
        <receiver
            android:name=".receiver.LlmResultReceiver"
            android:exported="true"
            android:permission="com.voxapps.vox.permission.LLM_RESULT">
            <intent-filter>
                <action android:name="com.voxapps.action.LLM_RESULT" />
            </intent-filter>
        </receiver>

        <!--
            OCR-scan result: Vision delivers an async reply here after scanning a receipt Expenses
            asked it to (the "Scan receipt" entry point). Guarded by the shared OCR_RESULT permission
            — only same-signing-key apps can deliver it. The ocr.task meta-data is what Vision's
            dynamic "send scan to this app" dispatcher discovery reads to build a button.
        -->
        <receiver
            android:name=".receiver.OcrResultReceiver"
            android:exported="true"
            android:permission="com.voxapps.vox.permission.OCR_RESULT">
            <intent-filter>
                <action android:name="com.voxapps.action.OCR_RESULT" />
            </intent-filter>
            <meta-data android:name="com.voxapps.vox.ocr.task" android:value="EXPENSE_SCAN_CLEANUP" />
        </receiver>

        <!-- NotificationListenerService for opt-in payment-notification capture (Stage 6) — mirrors
             vox-commander's MediaSessionListenerService shape. Granting this in system Settings only
             lets the service exist; onNotificationPosted still ignores everything not in the user's
             explicit payment-source app allowlist (see NotificationCaptureSettingsTab), so enabling
             this permission alone processes nothing. -->
        <service
            android:name=".receiver.PaymentNotificationListenerService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Grants Hub temporary read access to a zipped bundle of receipt photos during export
             (see VoxResult.attachmentUri) — mirrors vox-vision's identical FileProvider setup for
             the same reason (sharing a locally-built file across app processes). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.voxapps.expenses.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".ui.widget.ExpensesWidgetReceiver"
            android:exported="false"
            android:label="@string/expenses_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/expenses_widget_info" />
        </receiver>
    </application>
</manifest>
