VoxApps patch 0002: OpenCV 5 geometry API.

Upstream PaddleOCR targets OpenCV 4.x, where minAreaRect and getPerspectiveTransform live
on Imgproc. We build OpenCV 5.0, which moved both into org.opencv.geometry.Geometry. Without
this, a re-vendor of these two files leaves Imgproc.minAreaRect unresolved — and because the
RotatedRect it returns then has no type, .size and .points fail too, so one missing symbol
reads as a dozen unrelated errors.

git apply skips this preamble and starts at the first diff header below.

diff --git a/vendor/ppocr-sdk/src/main/java/com/paddle/ocr/postprocess/DBPostProcessor.kt b/vendor/ppocr-sdk/src/main/java/com/paddle/ocr/postprocess/DBPostProcessor.kt
--- a/vendor/ppocr-sdk/src/main/java/com/paddle/ocr/postprocess/DBPostProcessor.kt
+++ b/vendor/ppocr-sdk/src/main/java/com/paddle/ocr/postprocess/DBPostProcessor.kt
@@ -24,6 +24,7 @@ import org.opencv.core.MatOfPoint
 import org.opencv.core.MatOfPoint2f
 import org.opencv.core.Point
 import org.opencv.core.Scalar
+import org.opencv.geometry.Geometry
 import org.opencv.imgproc.Imgproc
 
 object DBPostProcessor {
@@ -85,7 +86,7 @@ object DBPostProcessor {
                 val contour = contours[index]
                 val contour2f = MatOfPoint2f(*contour.toArray())
                 val rect = try {
-                    Imgproc.minAreaRect(contour2f)
+                    Geometry.minAreaRect(contour2f)
                 } finally {
                     contour2f.release()
                 }
@@ -106,7 +107,7 @@ object DBPostProcessor {
                 val expandedRect = MatOfPoint2f().let { expanded2f ->
                     try {
                         expanded2f.fromList(expandedPts)
-                        Imgproc.minAreaRect(expanded2f)
+                        Geometry.minAreaRect(expanded2f)
                     } finally {
                         expanded2f.release()
                     }
diff --git a/vendor/ppocr-sdk/src/main/java/com/paddle/ocr/postprocess/QuadTextCrop.kt b/vendor/ppocr-sdk/src/main/java/com/paddle/ocr/postprocess/QuadTextCrop.kt
--- a/vendor/ppocr-sdk/src/main/java/com/paddle/ocr/postprocess/QuadTextCrop.kt
+++ b/vendor/ppocr-sdk/src/main/java/com/paddle/ocr/postprocess/QuadTextCrop.kt
@@ -21,6 +21,7 @@ import org.opencv.core.Mat
 import org.opencv.core.MatOfPoint2f
 import org.opencv.core.Point
 import org.opencv.core.Size
+import org.opencv.geometry.Geometry
 import org.opencv.imgproc.Imgproc
 import kotlin.math.hypot
 import kotlin.math.max
@@ -34,7 +35,7 @@ object QuadTextCrop {
         val rectPoints = box.points.map { Point(it.x.toDouble(), it.y.toDouble()) }
         val rectInput = MatOfPoint2f()
         rectInput.fromList(rectPoints)
-        val boundingBox = Imgproc.minAreaRect(rectInput)
+        val boundingBox = Geometry.minAreaRect(rectInput)
         rectInput.release()
 
         val boxPoints = Array(4) { Point() }
@@ -60,7 +61,7 @@ object QuadTextCrop {
                 Point(0.0, dstH.toDouble()),
             )
         )
-        val m = Imgproc.getPerspectiveTransform(srcPts, dstPts)
+        val m = Geometry.getPerspectiveTransform(srcPts, dstPts)
         srcPts.release()
         dstPts.release()
 
