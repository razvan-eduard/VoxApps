<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Staged AI-attachment copy of a scanned photo, for the one-shot Commander LLM call —
         short-lived by design, so this is cache, not files. -->
    <cache-path name="ai_scans" path="ai_scans/" />
    <!-- Zipped attachments bundle staged for a Hub export — see NotesExportImportHandler.buildAttachmentsZip. -->
    <cache-path name="exports" path="exports/" />
    <!-- Per-note attachments (scanned photo kept per NotesSettings.scanImageRetention, plus any
         manually-added photos) — durable, not evictable like cache. See :core:attachments. -->
    <files-path name="attachments" path="attachments/" />
</paths>
