<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Private, on-device notes. No network permission by design. -->

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoxNotes">

        <activity
            android:name=".NotesActivity"
            android:exported="true"
            android:label="@string/app_name">

            <!-- Standalone launcher: works fully without VoxCommander -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OPTIONAL Vox integration: if VoxCommander is installed it can hand this app a
                 command via a native intent. Parsed with plain Android APIs (no shared library). -->
            <intent-filter>
                <action android:name="com.voxapps.action.HANDLE" />
                <category android:name="com.voxapps.category.VOX" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
