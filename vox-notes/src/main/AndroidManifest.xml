<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Private, on-device notes. No network permission by design. -->

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Android 13+ suppresses toasts from backgrounded apps unless notifications are allowed.
         Needed for the "toast on voice save" setting (the save is headless via broadcast). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Custom permission guarding the cross-app command bus. Any app that wants to send Vox
        commands to Notes must hold it. `signature` = only apps signed with the same key (the
        monorepo apps) qualify; loosen to `normal` if Commander ships under a different key.
    -->
    <permission
        android:name="com.voxapps.notes.permission.COMMAND"
        android:protectionLevel="signature" />

    <!--
        Guards Notes' own generic-LLM-hook result receiver — only Commander (same signing key) may
        deliver an async LLM reply here, so a third app can't spoof a fake category-merge suggestion.
    -->
    <permission
        android:name="com.voxapps.notes.permission.LLM_RESULT"
        android:protectionLevel="signature" />

    <!-- Held so Notes can send a generic LLM request to Commander's hook. -->
    <uses-permission android:name="com.voxapps.commander.permission.LLM_PROCESS" />

    <!--
        Guards Notes' OCR-scan result receiver — only Vision (same signing key) may deliver an async
        scan reply here, so a third app can't spoof fake OCR text into a note.
    -->
    <permission
        android:name="com.voxapps.notes.permission.OCR_RESULT"
        android:protectionLevel="signature" />

    <application
        android:name=".NotesApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoxNotes">

        <activity
            android:name=".NotesActivity"
            android:exported="true"
            android:label="@string/app_name">

            <!-- Standalone launcher: works fully without VoxCommander -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            OPTIONAL Vox integration: VoxCommander (or any authorized app) hands us a JSON command
            (create/read) via this native broadcast. Parsed with :core:ipc — no shared runtime, no
            NLU here. Guarded by the COMMAND permission above.
        -->
        <receiver
            android:name=".receiver.VoxCommandReceiver"
            android:exported="true"
            android:permission="com.voxapps.notes.permission.COMMAND">
            <intent-filter>
                <action android:name="com.voxapps.action.VOX_COMMAND" />
            </intent-filter>
            <!-- Capability advertising: Commander reads this at scan time to route the "notes" NLU
                 domain here (create/read), with no per-app config on Commander's side. -->
            <meta-data android:name="com.voxapps.vox.domain" android:value="notes" />
            <meta-data android:name="com.voxapps.vox.actions" android:value="create,read" />
            <meta-data android:name="com.voxapps.vox.label" android:value="Notes" />
            <meta-data
                android:name="com.voxapps.vox.nluHint"
                android:value="If the user names a target list/category (e.g. &quot;note it in shopping&quot;, &quot;adaugă la cumpărături&quot;, &quot;in the work list&quot;), put that category name in the category field; otherwise category=null." />
        </receiver>

        <!--
            Generic LLM hook result: Commander delivers an async reply here after processing a raw
            prompt Notes sent it (e.g. the category auto-merge mapping). Guarded by the LLM_RESULT
            permission above — only Commander (same signing key) can deliver it.
        -->
        <receiver
            android:name=".receiver.LlmResultReceiver"
            android:exported="true"
            android:permission="com.voxapps.notes.permission.LLM_RESULT">
            <intent-filter>
                <action android:name="com.voxapps.action.LLM_RESULT" />
            </intent-filter>
        </receiver>

        <!--
            OCR-scan result: Vision delivers an async reply here after scanning a document Notes
            asked it to (the "Scanează o notiță" entry point). Guarded by the OCR_RESULT permission
            above — only Vision (same signing key) can deliver it.
        -->
        <receiver
            android:name=".receiver.OcrResultReceiver"
            android:exported="true"
            android:permission="com.voxapps.notes.permission.OCR_RESULT">
            <intent-filter>
                <action android:name="com.voxapps.action.OCR_RESULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
