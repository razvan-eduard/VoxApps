<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Staged AI-attachment copy of a scanned photo, for the one-shot Commander LLM call —
         short-lived by design, so this is cache, not files. -->
    <cache-path name="ai_scans" path="ai_scans/" />
    <!-- Temp file for a camera-captured attachment photo, before AttachmentFileStore.stage() copies
         it into files/attachments/ — see :core:attachments' CameraCapture.kt. -->
    <cache-path name="camera" path="camera/" />
    <!-- Zipped attachments bundle staged for a Hub export — see CalendarExportImportHandler.buildAttachmentsZip. -->
    <cache-path name="exports" path="exports/" />
    <!-- Manually-added attachments on a calendar entry — see :core:attachments. -->
    <files-path name="attachments" path="attachments/" />
</paths>
