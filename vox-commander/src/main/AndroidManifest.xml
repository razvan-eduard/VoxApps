<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Needed for SystemIntentHandler's Do Not Disturb / silent-mode toggles (normal permission;
         the user still has to separately grant "notification policy access" via the system
         settings screen this app opens on first use — NotificationManager.isNotificationPolicyAccessGranted). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Needed for SystemIntentHandler's auto-rotate toggle (Settings.System.putInt). This is a
         special/"Modify system settings" permission — declaring it here is required, but it's only
         actually granted via the ACTION_MANAGE_WRITE_SETTINGS screen this app opens on first use. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Lets the onboarding/General settings screen show the system's "Ignore battery
         optimizations?" dialog directly (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS) — without
         this, some OEMs' aggressive background-process killers unbind WakeWordService while
         backgrounded, silently dropping wake-word detection until the OS gets around to rebinding it. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Custom permission for external voice trigger (MacroDroid, Tasker, etc.) -->
    <permission
        android:name="com.voxapps.commander.permission.TRIGGER_VOICE"
        android:protectionLevel="normal"
        android:label="Trigger VoxCommander Voice Assistant" />

    <!-- Custom permission guarding the TTS hook (any app can ask Commander to speak text). -->
    <permission
        android:name="com.voxapps.commander.permission.SPEAK"
        android:protectionLevel="signature"
        android:label="Speak text via VoxCommander TTS" />

    <!--
        The COMMAND/LLM_RESULT/LLM_PROCESS signature permissions Commander needs to talk to any
        satellite (and let satellites call its LLM hook) are declared once in :core:ipc's own manifest
        (shared across every Vox app) and folded in here automatically via manifest merger — see
        VoxIpc.kt's class doc comment. No per-satellite <uses-permission> lines needed here, for any
        satellite, ever — this is also what makes it structurally impossible to forget one, unlike the
        old per-satellite-named scheme.
    -->

    <application
        android:name=".VoxApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoxCommander">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.VoxCommander.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Digital Assistant intent - may give priority to SpeechRecognizer -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Spotify App Remote OAuth redirect URI -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="voxcommander" android:host="spotify" android:pathPrefix="/callback" />
            </intent-filter>
            <!-- Shared OAuth redirect URI for declarative API integrations (ApiIntegrationRegistry).
                 Registered once, ever — every future OAuth-based service reuses this and routes
                 through OAuth2Manager's `state`-param service resolution, needing zero new manifest
                 entries per service. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="voxcommander" android:host="oauth" android:pathPrefix="/callback" />
            </intent-filter>
        </activity>
        
        <service
            android:name=".service.WakeWordService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- NotificationListenerService for media session access (playFromSearch) -->
        <service
            android:name=".service.MediaSessionListenerService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Runs the Vulkan GPU self-test in an isolated process so a native GPU crash
             cannot take down the main app. -->
        <service
            android:name=".domain.diagnostic.VulkanProbeService"
            android:enabled="true"
            android:exported="false"
            android:process=":vulkanprobe" />

        <!-- BroadcastReceiver for download completion in background -->
        <receiver
            android:name=".data.remote.DownloadCompleteReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- BroadcastReceiver for external voice trigger (MacroDroid, Tasker, etc.) -->
        <receiver
            android:name=".service.VoiceTriggerReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.voxapps.commander.permission.TRIGGER_VOICE">
            <intent-filter>
                <action android:name="com.voxapps.commander.TRIGGER_VOICE" />
            </intent-filter>
        </receiver>

        <!-- TTS hook: speak text with Commander's TTS settings, bypassing NLU. -->
        <receiver
            android:name=".service.TtsHookReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.voxapps.commander.permission.SPEAK">
            <intent-filter>
                <action android:name="com.voxapps.action.SPEAK" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.TtsHookService"
            android:enabled="true"
            android:exported="false" />

        <!-- Generic LLM hook: a first-party satellite can ask Commander's currently-selected LLM to
             process a raw prompt and get an async reply back via ACTION_LLM_RESULT. -->
        <receiver
            android:name=".service.LlmHookReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.voxapps.vox.permission.LLM_PROCESS">
            <intent-filter>
                <action android:name="com.voxapps.action.LLM_PROCESS" />
            </intent-filter>
        </receiver>

        <!-- Vox command bus entry point: lets Vox Hub discover Commander and export/import its
             settings (see VoxCommandReceiver's own doc comment for why only ping/export/import are
             handled here). -->
        <receiver
            android:name=".receiver.VoxCommandReceiver"
            android:exported="true"
            android:permission="com.voxapps.vox.permission.COMMAND">
            <intent-filter>
                <action android:name="com.voxapps.action.VOX_COMMAND" />
            </intent-filter>
            <meta-data android:name="com.voxapps.vox.domain" android:value="commander" />
            <meta-data android:name="com.voxapps.vox.actions" android:value="ping,export,import,media_control" />
            <meta-data android:name="com.voxapps.vox.label" android:value="Vox Commander" />
        </receiver>

        <!-- Satellite-initiated push: a satellite's own dynamic context (categories, etc.) changed,
             so the cached schema in VoxSatelliteRegistry needs correcting immediately. -->
        <receiver
            android:name=".domain.integration.SchemaChangedReceiver"
            android:exported="true"
            android:permission="com.voxapps.vox.permission.SCHEMA_CHANGED">
            <intent-filter>
                <action android:name="com.voxapps.action.SCHEMA_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Any first-party app can synchronously ask which capabilities Commander's currently-
             configured engine has (e.g. Vision, before deciding whether to attach a scanned photo). -->
        <receiver
            android:name=".service.CapabilityQueryReceiver"
            android:exported="true"
            android:permission="com.voxapps.vox.permission.CAPABILITY_QUERY">
            <intent-filter>
                <action android:name="com.voxapps.action.CAPABILITY_QUERY" />
            </intent-filter>
        </receiver>

        <!-- Independent "tap to speak" home-screen widget — not tied to any satellite's data, just a
             direct trigger into the voice-capture flow MainScreen's own mic button already uses. -->
        <receiver
            android:name=".ui.widget.SpeakWidgetReceiver"
            android:exported="false"
            android:label="@string/speak_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/speak_widget_info" />
        </receiver>

        <!-- The vendor OpenCL driver the GPU backend links against. Being listed in the
             platform's public.libraries.txt is not enough on its own: an app's linker namespace
             resolves a vendor library only when the app declares it here. Optional, because the
             library is a GPU-vendor component — a device without it must still install and run
             on the CPU. -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
    </application>

</manifest>