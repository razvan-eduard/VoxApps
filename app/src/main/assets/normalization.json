      "description": "Regex-Pipeline von spezifisch (Interceptoren) zu allgemein (Sweeper)",
      "rules": [
        {
          "description": "[Interceptor] Ein Grad Celsius (Singular: 1 oder -1)",
          "pattern": "(?<!\\d)(-?1)\\s*°?\\s*[cC]\\b",
          "replacement": "$1 Grad Celsius"
        },
        {
          "description": "[Interceptor] Ein Grad Fahrenheit (Singular)",
          "pattern": "(?<!\\d)(-?1)\\s*°?\\s*[fF]\\b",
          "replacement": "$1 Grad Fahrenheit"
        },
        {
          "description": "[Sweeper] Plural Grad Celsius",
          "pattern": "(-?\\d+(?:[.,]\\d+)?)\\s*°?\\s*[cC]\\b",
          "replacement": "$1 Grad Celsius"
        },
        {
          "description": "[Sweeper] Plural Grad Fahrenheit",
          "pattern": "(-?\\d+(?:[.,]\\d+)?)\\s*°?\\s*[fF]\\b",
          "replacement": "$1 Grad Fahrenheit"
        },
        {
          "description": "[Interceptor] Uhrzeit genau (15:00 -> 15 Uhr)",
          "pattern": "\\b(\\d{1,2}):(00)\\b",
          "replacement": "$1 Uhr"
        },
        {
          "description": "[Interceptor] Uhrzeit mit AM",
          "pattern": "\\b(\\d{1,2}):(\\d{2})\\s*[Aa]\\.[Mm]\\.",
          "replacement": "$1 Uhr $2 morgens"
        },
        {
          "description": "[Interceptor] Uhrzeit mit PM",
          "pattern": "\\b(\\d{1,2}):(\\d{2})\\s*[Pp]\\.[Mm]\\.",
          "replacement": "$1 Uhr $2 nachmittags"
        },
        {
          "description": "[Sweeper] Allgemeine Uhrzeit HH:MM",
          "pattern": "\\b(\\d{1,2}):(\\d{2})\\b",
          "replacement": "$1 Uhr $2"
        },
        {
          "description": "[Interceptor] ISO-Datum (YYYY-MM-DD)",
          "pattern": "\\b(\\d{4})-(\\d{2})-(\\d{2})\\b",
          "replacement": "$1 $2 $3"
        },
        {
          "description": "[Interceptor] Datum DD.MM.YYYY",
          "pattern": "\\b(\\d{1,2})\\.(\\d{1,2})\\.(\\d{4})\\b",
          "replacement": "$1 $2 $3"
        },
        {
          "description": "[Interceptor] Euro mit Cent (€5,99)",
          "pattern": "€(\\d+),(\\d{2})\\b",
          "replacement": "$1 Euro und $2 Cent"
        },
        {
          "description": "[Sweeper] Euro allgemein (€100)",
