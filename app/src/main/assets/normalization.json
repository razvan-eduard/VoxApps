          "replacement": "$1 Dollar"
        },
        {
          "description": "[Interceptor] Prozent mit Dezimal (50,5%)",
          "pattern": "(?<!\\d)(\\d+[.,]\\d+)\\s*%",
          "replacement": "$1 Prozent"
        },
        {
          "description": "[Sweeper] Prozent allgemein (50%)",
          "pattern": "(?<!\\d)(\\d+)\\s*%",
          "replacement": "$1 Prozent"
        },
        {
          "description": "[Interceptor] Negativer Dezimalwert (-3,14)",
