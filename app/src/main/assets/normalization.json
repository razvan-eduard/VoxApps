    "layer_2_regex": {
      "description": "Regex pipeline ordered from most specific (interceptors) to least specific (sweepers)",
      "rules": [
        {
          "description": "[Interceptor] Negative one degree celsius (singular exception)",
          "pattern": "(?<!\\d)(-1)\\s*°?\\s*[cC]\\b",
          "replacement": "$1 degree celsius"
        },
        {
          "description": "[Interceptor] One degree celsius (singular exception, isolated digit)",
          "pattern": "(?<!\\d)(1)\\s*°?\\s*[cC]\\b",
          "replacement": "$1 degree celsius"
        },
        {
          "description": "[Interceptor] One degree fahrenheit (singular exception)",
          "pattern": "(?<!\\d)(1)\\s*°?\\s*[fF]\\b",
          "replacement": "$1 degree fahrenheit"
        },
        {
          "description": "[Sweeper] Plural degrees celsius (any remaining number)",
          "pattern": "(-?\\d+(?:\\.\\d+)?)\\s*°?\\s*[cC]\\b",
          "replacement": "$1 degrees celsius"
        },
        {
          "description": "[Sweeper] Plural degrees fahrenheit",
          "pattern": "(-?\\d+(?:\\.\\d+)?)\\s*°?\\s*[fF]\\b",
          "replacement": "$1 degrees fahrenheit"
        },
        {
          "description": "[Sweeper] Plural degrees kelvin",
          "pattern": "(-?\\d+(?:\\.\\d+)?)\\s*°?\\s*[kK]\\b",
          "replacement": "$1 degrees kelvin"
        },
        {
          "description": "[Interceptor] First ordinal (1st -> first)",
          "pattern": "(?<!\\d)1st\\b",
          "replacement": "first"
        },
        {
          "description": "[Interceptor] Second ordinal (2nd -> second)",
          "pattern": "(?<!\\d)2nd\\b",
          "replacement": "second"
        },
        {
          "description": "[Interceptor] Third ordinal (3rd -> third)",
          "pattern": "(?<!\\d)3rd\\b",
          "replacement": "third"
        },
        {
          "description": "[Interceptor] Time with AM",
          "pattern": "\\b(\\d{1,2}):(\\d{2})\\s*[Aa]\\.[Mm]\\.",
          "replacement": "$1 $2 AM"
        },
        {
          "description": "[Interceptor] Time with PM",
          "pattern": "\\b(\\d{1,2}):(\\d{2})\\s*[Pp]\\.[Mm]\\.",
          "replacement": "$1 $2 PM"
        },
        {
          "description": "[Interceptor] Time with o'clock",
          "pattern": "\\b(\\d{1,2})\\s*o'?clock\\b",
          "replacement": "$1 o'clock"
        },
        {
          "description": "[Sweeper] General time format HH:MM",
          "pattern": "\\b(\\d{1,2}):(\\d{2})\\b",
          "replacement": "$1 $2"
        },
        {
          "description": "[Interceptor] US date MM/DD/YYYY",
          "pattern": "\\b(\\d{1,2})/(\\d{1,2})/(\\d{4})\\b",
          "replacement": "$1 $2 $3"
        },
        {
          "description": "[Interceptor] ISO date YYYY-MM-DD",
          "pattern": "\\b(\\d{4})-(\\d{2})-(\\d{2})\\b",
          "replacement": "$1 $2 $3"
        },
        {
          "description": "[Interceptor] Dollar amount with cents ($5.99)",
          "pattern": "\\$(\\d+)\\.(\\d{2})\\b",
          "replacement": "$1 dollars and $2 cents"
        },
        {
          "description": "[Sweeper] General dollar amount ($100)",
          "pattern": "\\$(\\d+(?:,\\d{3})*)\\b",
          "replacement": "$1 dollars"
        },
        {
          "description": "[Interceptor] Euro amount with cents (€5.99)",
          "pattern": "€(\\d+)\\.(\\d{2})\\b",
          "replacement": "$1 euros and $2 cents"
        },
        {
          "description": "[Sweeper] General euro amount (€100)",
          "pattern": "€(\\d+(?:,\\d{3})*)\\b",
          "replacement": "$1 euros"
        },
        {
          "description": "[Interceptor] Pound amount with cents (£5.99)",
          "pattern": "£(\\d+)\\.(\\d{2})\\b",
          "replacement": "$1 pounds and $2 pence"
        },
        {
          "description": "[Sweeper] General pound amount (£100)",
          "pattern": "£(\\d+(?:,\\d{3})*)\\b",
          "replacement": "$1 pounds"
        },
        {
          "description": "[Interceptor] Percentage with decimal (50.5%)",
          "pattern": "(?<!\\d)(\\d+\\.\\d+)\\s*%",
          "replacement": "$1 percent"
        },
        {
          "description": "[Sweeper] General percentage (50%)",
          "pattern": "(?<!\\d)(\\d+)\\s*%",
          "replacement": "$1 percent"
        },
        {
          "description": "[Interceptor] Negative decimal (-3.14)",
          "pattern": "(?<!\\d)-(\\d+\\.\\d+)\\b",
          "replacement": "minus $1"
        },
        {
          "description": "[Sweeper] Decimal number (3.14 -> 3 point 14)",
          "pattern": "(?<!\\d)(\\d+)\\.(\\d+)\\b",
          "replacement": "$1 point $2"
        },
        {
          "description": "[Interceptor] Thousand separator (1,000 -> 1000)",
          "pattern": "(?<!\\d)(\\d{1,3}),(\\d{3})\\b",
          "replacement": "$1$2"
        },
        {
          "description": "[Interceptor] Million separator (1,000,000)",
          "pattern": "(?<!\\d)(\\d{1,3}),(\\d{3}),(\\d{3})\\b",
          "replacement": "$1$2$3"
        },
        {
          "description": "[Interceptor] Speed km/h",
          "pattern": "(?<!\\d)(\\d+(?:\\.\\d+)?)\\s*km/h\\b",
          "replacement": "$1 kilometers per hour"
        },
        {
          "description": "[Interceptor] Speed mph",
          "pattern": "(?<!\\d)(\\d+(?:\\.\\d+)?)\\s*mph\\b",
          "replacement": "$1 miles per hour"
        },
        {
          "description": "[Sweeper] Kilometers with number",
          "pattern": "(?<!\\d)(\\d+(?:\\.\\d+)?)\\s*km\\b",
          "replacement": "$1 kilometers"
        },
        {
          "description": "[Sweeper] Meters with number",
          "pattern": "(?<!\\d)(\\d+(?:\\.\\d+)?)\\s*\\bm\\b",
          "replacement": "$1 meters"
        },
        {
          "description": "[Sweeper] Kilograms with number",
          "pattern": "(?<!\\d)(\\d+(?:\\.\\d+)?)\\s*kg\\b",
          "replacement": "$1 kilograms"
        },
        {
          "description": "[Sweeper] Watts with number",
          "pattern": "(?<!\\d)(\\d+(?:\\.\\d+)?)\\s*W\\b",
          "replacement": "$1 watts"
        },
        {
          "description": "[Interceptor] URL with protocol",
          "pattern": "\\bhttps?://[^\\s]+",
          "replacement": "URL"
        },
        {
          "description": "[Interceptor] Email address",
          "pattern": "\\b[\\w.+-]+@[\\w.-]+\\.\\w+\\b",
          "replacement": "email address"
        },
        {
          "description": "[Interceptor] Phone number US format",
          "pattern": "\\+?1?\\s*\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}\\b",
          "replacement": "phone number"
        },
        {
          "description": "[Interceptor] International phone number",
          "pattern": "\\+\\d{1,3}[\\s-]?\\d{1,}[\\s-]?\\d{1,}",
          "replacement": "phone number"
        },
        {
          "description": "[Sweeper] Remaining standalone negative numbers",
          "pattern": "(?<!\\w)-(\\d+)\\b",
          "replacement": "minus $1"
        },
        {
          "description": "[Interceptor] Year range (2020-2025)",
          "pattern": "\\b(\\d{4})-(\\d{4})\\b",
          "replacement": "$1 to $2"
        },
        {
          "description": "[Interceptor] Number range (5-10)",
          "pattern": "(?<!\\d)(\\d+)-(\\d+)\\b",
          "replacement": "$1 to $2"
        }
      ]
    },
    "layer_3_cleanup": {
      "description": "Sanitizer: clean up artifacts from Layer 1 and 2 mutations",
      "rules": {
        "\\s{2,}": " ",
        "\\s+\\.": ".",
        "\\s+,": ",",
        "\\s+;": ";",
        "\\s+:": ":",
        "\\s+\\?": "?",
        "\\s+!": "!",
        "^\\s+": "",
        "\\s+$": "",
        "\\(\\s+": "(",
        "\\s+\\)": ")"
      }
    }
  },
