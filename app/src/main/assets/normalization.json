    "layer_2_regex": {
      "description": "Pipeline regex ordonat de la cel mai specific (interceptori) la cel mai general (mături)",
      "rules": [
        {
          "description": "[Interceptor] Un grad celsius (singular, izolat: 1 sau -1)",
          "pattern": "(?<!\\d)(-?1)\\s*°?\\s*[cC]\\b",
          "replacement": "$1 grad celsius"
        },
        {
          "description": "[Interceptor] Un grad fahrenheit (singular, izolat)",
          "pattern": "(?<!\\d)(-?1)\\s*°?\\s*[fF]\\b",
          "replacement": "$1 grad fahrenheit"
        },
        {
          "description": "[Sweeper] Grade celsius plural (orice număr rămas)",
          "pattern": "(-?\\d+(?:[.,]\\d+)?)\\s*°?\\s*[cC]\\b",
          "replacement": "$1 grade celsius"
        },
        {
          "description": "[Sweeper] Grade fahrenheit plural",
          "pattern": "(-?\\d+(?:[.,]\\d+)?)\\s*°?\\s*[fF]\\b",
          "replacement": "$1 grade fahrenheit"
        },
        {
          "description": "[Sweeper] Grade kelvin plural",
          "pattern": "(-?\\d+(?:[.,]\\d+)?)\\s*°?\\s*[kK]\\b",
          "replacement": "$1 grade kelvin"
        },
        {
          "description": "[Interceptor] Ora exactă (15:00 -> 15 fix)",
          "pattern": "\\b(\\d{1,2}):(00)\\b",
          "replacement": "$1 fix"
        },
        {
          "description": "[Interceptor] Ora dimineața (9:30 AM)",
          "pattern": "\\b(\\d{1,2}):(\\d{2})\\s*[Aa]\\.[Mm]\\.",
          "replacement": "$1 și $2 dimineața"
        },
        {
          "description": "[Interceptor] Ora după-amiaza (9:30 PM)",
          "pattern": "\\b(\\d{1,2}):(\\d{2})\\s*[Pp]\\.[Mm]\\.",
          "replacement": "$1 și $2 după-amiaza"
        },
        {
          "description": "[Sweeper] Format general oră HH:MM",
          "pattern": "\\b(\\d{1,2}):(\\d{2})\\b",
          "replacement": "$1 și $2 minute"
        },
        {
          "description": "[Interceptor] Data ISO (YYYY-MM-DD)",
          "pattern": "\\b(\\d{4})-(\\d{2})-(\\d{2})\\b",
          "replacement": "$1 $2 $3"
        },
        {
          "description": "[Interceptor] Data format DD.MM.YYYY",
          "pattern": "\\b(\\d{1,2})\\.(\\d{1,2})\\.(\\d{4})\\b",
          "replacement": "$1 $2 $3"
        },
        {
          "description": "[Sweeper] Data format DD/MM/YYYY",
          "pattern": "\\b(\\d{1,2})/(\\d{1,2})/(\\d{4})\\b",
          "replacement": "$1 $2 $3"
        },
        {
          "description": "[Interceptor] Euro cu cenți (€5,99)",
          "pattern": "€(\\d+),(\\d{2})\\b",
          "replacement": "$1 euro și $2 cenți"
        },
        {
          "description": "[Sweeper] Euro general (€100)",
          "pattern": "€(\\d+(?:\\.\\d{3})*)\\b",
          "replacement": "$1 euro"
        },
        {
          "description": "[Interceptor] Dolari cu cenți ($5,99)",
          "pattern": "\\$(\\d+),(\\d{2})\\b",
          "replacement": "$1 dolari și $2 cenți"
        },
        {
          "description": "[Sweeper] Dolari general ($100)",
          "pattern": "\\$(\\d+(?:\\.\\d{3})*)\\b",
          "replacement": "$1 dolari"
        },
        {
          "description": "[Interceptor] Lei cu bani (5,99 lei)",
          "pattern": "(?<!\\d)(\\d+),(\\d{2})\\s*lei\\b",
          "replacement": "$1 lei și $2 bani"
        },
        {
          "description": "[Sweeper] Lei general (100 lei)",
          "pattern": "(?<!\\d)(\\d+(?:\\.\\d{3})*)\\s*lei\\b",
          "replacement": "$1 lei"
        },
        {
          "description": "[Interceptor] Procentaj zecimal (50,5%)",
          "pattern": "(?<!\\d)(\\d+[.,]\\d+)\\s*%",
          "replacement": "$1 la sută"
        },
        {
          "description": "[Sweeper] Procentaj general (50%)",
          "pattern": "(?<!\\d)(\\d+)\\s*%",
          "replacement": "$1 la sută"
        },
        {
          "description": "[Interceptor] Zecimal negativ cu virgulă (-3,14)",
          "pattern": "(?<!\\d)-(\\d+),(\\d+)\\b",
          "replacement": "minus $1 virgulă $2"
        },
        {
          "description": "[Sweeper] Zecimal cu virgulă (3,14 -> 3 virgulă 14)",
          "pattern": "(?<!\\d)(\\d+),(\\d+)\\b",
          "replacement": "$1 virgulă $2"
        },
        {
          "description": "[Sweeper] Zecimal cu punct (3.14 -> 3 virgulă 14)",
          "pattern": "(?<!\\d)(\\d+)\\.(\\d+)\\b",
          "replacement": "$1 virgulă $2"
        },
        {
          "description": "[Interceptor] Separator miimi (1.000 -> 1000)",
          "pattern": "(?<!\\d)(\\d{1,3})\\.(\\d{3})\\b",
          "replacement": "$1$2"
        },
        {
          "description": "[Interceptor] Separator milioane (1.000.000)",
          "pattern": "(?<!\\d)(\\d{1,3})\\.(\\d{3})\\.(\\d{3})\\b",
          "replacement": "$1$2$3"
        },
        {
          "description": "[Interceptor] Viteză km/h",
          "pattern": "(?<!\\d)(\\d+(?:[.,]\\d+)?)\\s*km/h\\b",
          "replacement": "$1 kilometri pe oră"
        },
        {
          "description": "[Sweeper] Kilometri cu număr",
          "pattern": "(?<!\\d)(\\d+(?:[.,]\\d+)?)\\s*km\\b",
          "replacement": "$1 kilometri"
        },
