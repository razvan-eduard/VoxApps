{
  "schema_version": 3,
  "integrations": [
    {
      "id": "spotify",
      "label": "Spotify",
      "package_name": "com.spotify.music",
      "auth": {
        "type": "oauth2_pkce",
        "authorize_url": "https://accounts.spotify.com/authorize",
        "token_url": "https://accounts.spotify.com/api/token",
        "redirect_uri": "voxcommander://spotify/callback",
        "scopes": "user-read-playback-state user-modify-playback-state user-read-currently-playing streaming app-remote-control"
      },
      "base_url": "https://api.spotify.com/v1",
      "capabilities": {
        "search_track": {
          "type": "api_call",
          "method": "GET",
          "path": "/search?q={query}&type=track&limit=1",
          "response_path": "tracks.items[0].uri",
          "extract": { "artist_id": "tracks.items[0].artists[0].id" }
        },
        "search_album": {
          "type": "api_call",
          "method": "GET",
          "path": "/search?q={query}&type=album&limit=1",
          "response_path": "albums.items[0].uri"
        },
        "search_artist": {
          "type": "api_call",
          "method": "GET",
          "path": "/search?q={query}&type=artist&limit=1",
          "response_path": "artists.items[0].uri"
        },
        "play_track": {
          "type": "api_sequence",
          "steps": [
            { "capability": "search_track" },
            { "type": "api_call", "method": "GET", "path": "/me/player/devices", "response_path": "devices", "as": "devices", "optional": true },
            {
              "type": "device_select",
              "from": "devices",
              "prefer": [
                { "field": "type", "equals": "Smartphone" },
                { "field": "is_active", "equals": true },
                { "field": "type", "equals": "Computer" }
              ],
              "id_field": "id",
              "as": "device_id",
              "optional": true
            },
            { "type": "api_call", "method": "PUT", "path": "/me/player", "body": "{\"device_ids\":[\"{device_id}\"],\"play\":false}", "optional": true },
            {
              "type": "api_call",
              "group": "play",
              "method": "PUT",
              "path": "/me/player/play?device_id={device_id}",
              "body": "{\"uris\":[\"{search_track.result}\"]}",
              "delay_before_ms": 500,
              "retry": { "times": 1, "delay_ms": 2000 }
            },
            { "type": "api_call", "group": "play", "method": "PUT", "path": "/me/player/play", "body": "{\"uris\":[\"{search_track.result}\"]}" },
            {
              "type": "api_call",
              "method": "GET",
              "path": "/artists/{search_track.artist_id}/top-tracks",
              "response_path": "tracks",
              "as": "top_tracks",
              "optional": true
            },
            {
              "type": "queue_array",
              "from": "top_tracks",
              "uri_field": "uri",
              "limit": 4,
              "skip": "{search_track.result}",
              "queue_path": "/me/player/queue?uri={item}",
              "method": "POST",
              "optional": true
            }
          ]
        },
        "play_album": {
          "type": "api_sequence",
          "steps": [
            { "capability": "search_album" },
            { "type": "api_call", "method": "GET", "path": "/me/player/devices", "response_path": "devices", "as": "devices", "optional": true },
            {
              "type": "device_select",
              "from": "devices",
              "prefer": [
                { "field": "type", "equals": "Smartphone" },
                { "field": "is_active", "equals": true },
                { "field": "type", "equals": "Computer" }
              ],
              "id_field": "id",
              "as": "device_id",
              "optional": true
            },
            { "type": "api_call", "method": "PUT", "path": "/me/player", "body": "{\"device_ids\":[\"{device_id}\"],\"play\":false}", "optional": true },
            {
              "type": "api_call",
              "group": "play",
              "method": "PUT",
              "path": "/me/player/play?device_id={device_id}",
              "body": "{\"context_uri\":\"{search_album.result}\"}",
              "delay_before_ms": 500,
              "retry": { "times": 1, "delay_ms": 2000 }
            },
            { "type": "api_call", "group": "play", "method": "PUT", "path": "/me/player/play", "body": "{\"context_uri\":\"{search_album.result}\"}" }
          ]
        },
        "play_artist": {
          "type": "api_sequence",
          "steps": [
            { "capability": "search_artist" },
            { "type": "api_call", "method": "GET", "path": "/me/player/devices", "response_path": "devices", "as": "devices", "optional": true },
            {
              "type": "device_select",
              "from": "devices",
              "prefer": [
                { "field": "type", "equals": "Smartphone" },
                { "field": "is_active", "equals": true },
                { "field": "type", "equals": "Computer" }
              ],
              "id_field": "id",
              "as": "device_id",
              "optional": true
            },
            { "type": "api_call", "method": "PUT", "path": "/me/player", "body": "{\"device_ids\":[\"{device_id}\"],\"play\":false}", "optional": true },
            {
              "type": "api_call",
              "group": "play",
              "method": "PUT",
              "path": "/me/player/play?device_id={device_id}",
              "body": "{\"context_uri\":\"{search_artist.result}\"}",
              "delay_before_ms": 500,
              "retry": { "times": 1, "delay_ms": 2000 }
            },
            { "type": "api_call", "group": "play", "method": "PUT", "path": "/me/player/play", "body": "{\"context_uri\":\"{search_artist.result}\"}" }
          ]
        },
        "pause": { "type": "api_call", "method": "PUT", "path": "/me/player/pause" },
        "next": { "type": "api_call", "method": "POST", "path": "/me/player/next" },
        "prev": { "type": "api_call", "method": "POST", "path": "/me/player/previous" }
      }
    }
  ]
}
